# Source this profile before running campaign.sh on the NaCC RISC-V guest.

export LTP_DOCKER_IMAGE=ubuntu:22.04
export LTP_CASE_TIMEOUT_SECONDS=180

# The recorded campaign used the Docker daemon's NaCC-patched default runc and
# disabled seccomp for this LTP workload. Add --runtime=<name> only when the
# guest Docker configuration does not already select the NaCC runtime.
export NACC_DOCKER_ARGS='--security-opt=seccomp=unconfined'

export NACC_EXPECTED_BASELINE_ATTEMPTED=1494
export NACC_EXPECTED_NACC_SUBSET=911
